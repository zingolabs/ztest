# ztest git-lfs archive file-type matches
*.tar.zst filter=lfs diff=lfs merge=lfs -text
*.tar.gz  filter=lfs diff=lfs merge=lfs -text
*.tar.xz  filter=lfs diff=lfs merge=lfs -text
*.tar.bz2 filter=lfs diff=lfs merge=lfs -text
*.tar     filter=lfs diff=lfs merge=lfs -text
tests/assets/blob.bin filter=lfs diff=lfs merge=lfs -text

# Use regular git for toml manifests w/ ztest metadata
fixtures/chains/*.toml -filter -diff -merge text
tests/assets/*.toml -filter -diff -merge text
